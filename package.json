{
  "name": "todoservice-node",
  "version": "1.0.0",
  "description": "A demo Node.js TypeScript Web API for managing a todo list with PostgreSQL storage.",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "debug": "node --inspect --import tsx src/server.ts",
    "migrate:create": "db-migrate create --sql-file",
    "migrate:up": "db-migrate up",
    "migrate:down": "db-migrate down",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "db-migrate": "^0.11.14",
    "db-migrate-pg": "^1.5.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "jose": "^5.9.6",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
